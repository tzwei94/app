# Local build: docker build -f Dockerfile.local -t banking-api:local .
# Keep shared runtime and dependency updates aligned with Dockerfile.
FROM eclipse-temurin:25-jdk-jammy@sha256:0cbcd13ae550a9c8334d5ef4483a4247625f47067f16127e28638fdafaeb35ea AS certificates
ARG CA_BUNDLE_URL=https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
ARG CA_BUNDLE_SHA256=e5bb2084ccf45087bda1c9bffdea0eb15ee67f0b91646106e466714f9de3c7e3
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN curl --fail --silent --show-error --location "$CA_BUNDLE_URL" -o /rds-ca.pem \
    && printf '%s  /rds-ca.pem\n' "$CA_BUNDLE_SHA256" | sha256sum -c -

FROM maven:3.9.11-eclipse-temurin-25@sha256:407c4423cec0cf2981055bc2c6c0dc211d9605b6669279b95997f2d1c7e91e2c AS build
WORKDIR /build
# Wrapper checksum pins the ZIP distribution; unzip prevents tar.gz fallback.
RUN apt-get update && apt-get install -y --no-install-recommends unzip && rm -rf /var/lib/apt/lists/*
COPY pom.xml mvnw ./
COPY .mvn .mvn
COPY src src
RUN --mount=type=cache,target=/root/.m2 ./mvnw -B -DskipTests package

FROM eclipse-temurin:25-jdk-jammy@sha256:0cbcd13ae550a9c8334d5ef4483a4247625f47067f16127e28638fdafaeb35ea
ARG SOURCE_SHA=local
LABEL org.opencontainers.image.revision=$SOURCE_SHA
ENV SOURCE_SHA=$SOURCE_SHA
WORKDIR /app
# Keep local and CI runtimes on the same Jammy OpenSSL security fixes.
RUN apt-get update && apt-get install -y --no-install-recommends --only-upgrade openssl libssl3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=certificates /rds-ca.pem /opt/app/certs/rds-ca.pem
RUN mkdir -p /tmp /var/log/app \
    && chmod 755 /opt/app /opt/app/certs && chmod 644 /opt/app/certs/rds-ca.pem \
    && chmod 1777 /tmp \
    && chown 10001:10001 /var/log/app && chmod 700 /var/log/app
COPY --from=build --chown=10001:10001 /build/target/banking-api-*.jar /app/app.jar
VOLUME ["/tmp", "/var/log/app"]
USER 10001:10001
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
